		</div>

		<div class="col-md-4">
			<div class="card">
				<img src="https://m.media-amazon.com/images/I/714Y4KXLVPL._AC_UF894,1000_QL80_.jpg" class="card-img-top">
				<div class="card-body">
					<h5 class="card-title">Teclado</h5>
					<p class="card-text">Teclado gamer RGB.</p>
					<button class="btn btn-success">Adicionar ao carrinho</button>
