@page
@model TI48_AspNetCore.Pages.CatalogoModel
@{
}

<div class="container mt-4">

	<h2>Catálogo de Produtos</h2>

	<div class="row">

		<div class="col-md-4">
			<div class="card">
				<img src="https://www.tecmobile.com.br/wp-content/uploads/2021/10/Dell-inspiron-15-3000.jpg" class="card-img-top">
				<div class="card-body">
